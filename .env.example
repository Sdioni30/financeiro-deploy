# Copie este arquivo para .env e preencha com valores reais antes de subir.
# O arquivo .env nunca deve ser commitado no git.

# Banco de dados
DB_PASSWORD=senha_forte_aqui

# JWT — gere uma chave aleatória segura (mínimo 32 caracteres)
# PowerShell: -join ((1..32) | ForEach-Object { '{0:X2}' -f (Get-Random -Max 256) })
JWT_SECRET=substitua_por_uma_chave_longa_e_aleatoria
JWT_EXPIRATION=7200000

# URL pública da API (endereço do seu servidor)
VITE_API_URL=http://SEU_IP_OU_DOMINIO:8080
